(أعلن "تحميل TMQ v12")
(حدد تمق (اقرأ-جسون "bismillah/TMQ_v12.json"))
(حدد سجل-العقد (احصل "node_registry" تمق))
(حدد الأضلاع   (احصل "hyperedges"    تمق))
(أعلن "تم التحميل")

(حدد جذر-العقدة (لامدا (معرف)
  (احصل "root" (احصل معرف سجل-العقد))))

(حدد نوع-العقدة (لامدا (معرف)
  (احصل "pos" (احصل معرف سجل-العقد))))

(حدد موقع-العقدة (لامدا (معرف)
  (احصل "loc" (احصل معرف سجل-العقد))))

(حدد جذور-أضلاع (لامدا (قائمة-الأضلاع)
  (حذف-مكررات
    (ادمج
      (طبق (لامدا (ضلع)
        (رشح (لامدا (ج) ج)
          (طبق جذر-العقدة
            (أو (احصل "nodes" ضلع) (عدم)))))
        قائمة-الأضلاع)))))

(حدد فئات-مقاصد-الضلع (لامدا (ضلع)
  (إفعل
    (حدد مودال (احصل "modal" ضلع))
    (حدد طبقات (إذا مودال (احصل "ontological_layers" مودال) (عدم)))
    (إذا طبقات
      (رشح (لامدا (ف) ف)
        (طبق (لامدا (طبقة) (احصل "category" طبقة)) طبقات))
      (عدم)))))

(حدد عقد-في-آية (لامدا (سورة آية)
  (رشح (لامدا (معرف)
    (إفعل
      (حدد م (موقع-العقدة معرف))
      (إذا م
        (و (يساوي؟ (عنصر ١ م) سورة)
           (يساوي؟ (عنصر ٢ م) آية))
        خطأ)))
    (مفاتيح سجل-العقد))))

(أعلن "الطبقة الصفرية: المحمولات الإلهية")

(حدد عقد-الله
  (رشح (لامدا (معرف)
    (و (يساوي-نص؟ (جذر-العقدة معرف) "Alh")
       (يساوي-نص؟ (نوع-العقدة معرف) "PN")))
    (مفاتيح سجل-العقد)))

(قول "عقد الله:")
(قول (طول عقد-الله))

(حدد استخرج-خبر-الآية (لامدا (معرف-الله)
  (إفعل
    (حدد م (موقع-العقدة معرف-الله))
    (إذا م
      (إفعل
        (حدد سورة (عنصر ١ م))
        (حدد آية  (عنصر ٢ م))
        (حدد كلمة-الله (عنصر ٣ م))
        (حدد عقد-الآية (عقد-في-آية-سريع سورة آية))
        (رشح (لامدا (معرف-آخر)
          (إفعل
            (حدد م٢ (موقع-العقدة معرف-آخر))
            (حدد جذر (جذر-العقدة معرف-آخر))
            (حدد نوع (نوع-العقدة معرف-آخر))
            (إذا م٢
              (و جذر
                 (أكبر؟ (عنصر ٣ م٢) كلمة-الله)
                 (أو (يساوي-نص؟ نوع "N")
                     (يساوي-نص؟ نوع "PN")
                     (يساوي-نص؟ نوع "ADJ")))
              خطأ)))
          عقد-الآية))
      (عدم)))))

(حدد محمولات-إيجابية-خام
  (ادمج (طبق استخرج-خبر-الآية عقد-الله)))

(حدد محمولات-إيجابية
  (حذف-مكررات (طبق جذر-العقدة محمولات-إيجابية-خام)))

(قول "المحمولات الإيجابية:")
(قول (طول محمولات-إيجابية))

(حدد أضلاع-ضمير-إلهي (أضلاع-الفصيلة الأضلاع "SYN_PRON"))

(حدد طبقة-صفرية
  (كائن
    "عالم_مغلق"             صحيح
    "المحمولات_الإيجابية"    محمولات-إيجابية
    "عدد_المحمولات"          (طول محمولات-إيجابية)
    "عدد_أضلاع_الضمير"       (طول أضلاع-ضمير-إلهي)
    "تنزيه"                  صحيح
    "مرجع_التنزيه"           "ليس كمثله شيء — الشورى ١١"
    "قاعدة_الإغلاق"          "كل محمول على الله لا يرد في القائمة الإيجابية = مسار محظور"))

(قول "اكتملت الطبقة الصفرية")

(أعلن "الطبقة الأولى: التصنيف المعرفي")

(حدد عقد-العلم (رشح (لامدا (م) (يساوي-نص؟ (جذر-العقدة م) "Elm")) (مفاتيح سجل-العقد)))
(حدد عقد-الظن  (رشح (لامدا (م) (يساوي-نص؟ (جذر-العقدة م) "Znn")) (مفاتيح سجل-العقد)))
(حدد عقد-الغيب (رشح (لامدا (م) (يساوي-نص؟ (جذر-العقدة م) "gyb")) (مفاتيح سجل-العقد)))
(حدد عقد-النفي (رشح (لامدا (م) (يساوي-نص؟ (نوع-العقدة م) "NEG")) (مفاتيح سجل-العقد)))

(حدد طبقة-أولى
  (كائن
    "مصادر_العلم_الصحيح" (كائن
      "وصف"             "المعرفة المباشرة من الحواس أو الوحي"
      "جذر"             "Elm"
      "عدد_المواضع"      (طول عقد-العلم))
    "الظن_يُعلَّم" (كائن
      "وصف"             "الظن لا يغني من الحق شيئاً — يجب التمييز"
      "جذر"             "Znn"
      "عدد_المواضع"      (طول عقد-الظن)
      "حكم"             "يُتاح لكنه يجب أن يُوسَم ظناً لا علماً")
    "الغيب_محجوب" (كائن
      "وصف"             "ما غاب عن الحواس المباشرة"
      "جذر"             "gyb"
      "عدد_المواضع"      (طول عقد-الغيب)
      "حكم"             "وقف — لا جواب إلا من الوحي")
    "عدد_أدوات_النفي"    (طول عقد-النفي)
    "قاعدة_الإسناد"      "كل ادعاء يجب أن يحمل تصنيفه: علم أو ظن أو وقف"
    "مرجع"               "ولا تقف ما ليس لك به علم — الإسراء ٣٦"))

(قول "اكتملت الطبقة الأولى")

(أعلن "الطبقة الثانية: قيود الخطاب")

(حدد أضلاع-الصيغ (أضلاع-الفصيلة الأضلاع "FORMULA"))
(حدد جذور-الصيغ (جذور-أضلاع أضلاع-الصيغ))

(حدد طبقة-ثانية
  (كائن
    "قول_سديد" (كائن
      "مرجع"              "الأحزاب ٧٠"
      "تعريف"             "الصحيح بنيوياً — يطابق الحقيقة ويصلح الشأن"
      "شرط_الإنتاج"       "يجب أن يكون الخرج متسقاً مع الحق المعروف")
    "قول_لين" (كائن
      "مرجع"              "طه ٤٤"
      "تعريف"             "الرفيق — حتى في مواجهة المخطئ"
      "شرط_الإنتاج"       "تجنب العنف اللفظي والإكراه")
    "قول_معروف" (كائن
      "مرجع"              "البقرة ٢٣٥"
      "تعريف"             "المقبول الذي لا يؤذي"
      "شرط_الإنتاج"       "لا يسبب إيذاء أو فتنة")
    "اتساق_القول_والفعل" (كائن
      "مرجع"              "الصف ٢-٣"
      "تعريف"             "لا تقل ما لن تفعله"
      "شرط_الإنتاج"       "الخرج يتطابق مع الحالة الداخلية المعلنة")
    "عدد_الصيغ_القرآنية"  (طول أضلاع-الصيغ)
    "جذور_الصيغ"          جذور-الصيغ))

(قول "اكتملت الطبقة الثانية")

(أعلن "الطبقة الثالثة: بروتوكول التحقق")

(حدد أضلاع-الاستفهام (أضلاع-الفصيلة الأضلاع "SPEECH_ACT_ISTIFHAM"))

(حدد محظورات-قبل-التحقق
  (حرفي ("الحكم على النية"
          "انتقاء الهدف دون علم مباشر"
          "نسب القول لمن لم يقله"
          "التصرف على أساس الظن وحده في ما يضر"
          "نشر الخبر غير المتحقق منه")))

(حدد طبقة-ثالثة
  (كائن
    "التبيين_واجب"              صحيح
    "مرجع_التبيين"              "الحجرات ٦ — إن جاءكم فاسق بنبأ فتبينوا"
    "عتبات_التحقق" (كائن
      "ادعاء_عن_النية"           "وقف — الغيب محجوب"
      "ادعاء_عن_الغير"           "بينة مطلوبة قبل التصرف"
      "فعل_لا_رجوع_منه"          "تحقق كامل — الظن لا يكفي"
      "خبر_من_مجهول"             "تبين — لا تنقل ولا تتصرف حتى يتحقق")
    "سياقات_الاستفهام"          (طول أضلاع-الاستفهام)
    "محظورات_قبل_التحقق"        محظورات-قبل-التحقق
    "مرجع_البينة"               "قل هاتوا برهانكم — البقرة ١١١"
    "منطق_الوقف"                "ما لم يتحقق منه لا يتصرف به — والله أعلم"))

(قول "اكتملت الطبقة الثالثة")

(أعلن "الطبقة الرابعة: الأوامر والنواهي")

(حدد أضلاع-الأمر    (أضلاع-الفصيلة الأضلاع "SPEECH_ACT_AMR"))
(حدد أضلاع-النهي    (أضلاع-الفصيلة الأضلاع "SPEECH_ACT_NAHY"))
(حدد أضلاع-الإنذار  (أضلاع-الفصيلة الأضلاع "SPEECH_ACT_INDHAR"))
(حدد أضلاع-التبشير  (أضلاع-الفصيلة الأضلاع "SPEECH_ACT_TABSHIR"))

(قول "أضلاع الأمر:")  (قول (طول أضلاع-الأمر))
(قول "أضلاع النهي:")  (قول (طول أضلاع-النهي))

(حدد جذور-الأمر    (جذور-أضلاع أضلاع-الأمر))
(حدد جذور-النهي    (جذور-أضلاع أضلاع-النهي))
(حدد جذور-الإنذار  (جذور-أضلاع أضلاع-الإنذار))
(حدد جذور-التبشير  (جذور-أضلاع أضلاع-التبشير))

(حدد فئات-من-أضلاع (لامدا (قائمة-الأضلاع)
  (حذف-مكررات
    (ادمج
      (طبق (لامدا (ضلع)
        (أو (فئات-مقاصد-الضلع ضلع) (عدم)))
        قائمة-الأضلاع)))))

(حدد مقاصد-الأمر  (فئات-من-أضلاع أضلاع-الأمر))
(حدد مقاصد-النهي  (فئات-من-أضلاع أضلاع-النهي))

(حدد واجبات-مسماة
  (كائن
    "العدل"   (كائن "جذر" "Edl" "مرجع" "النساء ١٣٥" "تعريف" "الإنصاف ولو على النفس")
    "القسط"   (كائن "جذر" "qsT" "مرجع" "الحديد ٢٥"  "تعريف" "الميزان — لا تطغوا في الوزن")
    "الأمانة" (كائن "جذر" "Amn" "مرجع" "النساء ٥٨"  "تعريف" "أد الأمانة لأهلها")
    "الإحسان" (كائن "جذر" "Hsn" "مرجع" "النحل ٩٠"   "تعريف" "أكثر من الحد الأدنى")
    "الصدق"   (كائن "جذر" "Sdq" "مرجع" "التوبة ١١٩" "تعريف" "القول والفعل يتطابقان")
    "الصبر"   (كائن "جذر" "Sbr" "مرجع" "البقرة ١٥٣" "تعريف" "المثابرة لا اليأس")
    "الشكر"   (كائن "جذر" "skr" "مرجع" "إبراهيم ٧"  "تعريف" "الاعتراف بالمصدر")))

(حدد محرمات-مسماة
  (كائن
    "الكذب"   (كائن "جذر" "kzb" "مرجع" "التوبة ١١٩"   "حجب" "مسار الكذب لا ينتج")
    "الظلم"   (كائن "جذر" "Zlm" "مرجع" "آل عمران ١٠٨" "حجب" "لا ضرر بغير حق")
    "الكبر"   (كائن "جذر" "kbr" "مرجع" "النحل ٢٣"     "حجب" "لا إعلاء للنفس بلا حق")
    "الفساد"  (كائن "جذر" "fsd" "مرجع" "البقرة ١١"    "حجب" "لا إفساد في الأرض")
    "الإسراف" (كائن "جذر" "srf" "مرجع" "الأعراف ٣١"   "حجب" "لا تجاوز في الموارد")
    "الغيبة"  (كائن "جذر" "gyb" "مرجع" "الحجرات ١٢"   "حجب" "لا كلام على الغائب بما يكره")
    "البهتان" (كائن "جذر" "bht" "مرجع" "النور ١٦"     "حجب" "الاتهام الكاذب")
    "الفتنة"  (كائن "جذر" "ftn" "مرجع" "البقرة ١٩١"   "حجب" "الفتنة أشد من القتل")))

(حدد طبقة-رابعة
  (كائن
    "الواجبات" (كائن
      "جذور_من_TMQ"      جذور-الأمر
      "مقاصد_الأوامر"    مقاصد-الأمر
      "واجبات_مسماة"     واجبات-مسماة
      "عدد_أضلاع_الأمر"  (طول أضلاع-الأمر))
    "المحرمات" (كائن
      "جذور_من_TMQ"      جذور-النهي
      "مقاصد_النواهي"    مقاصد-النهي
      "محرمات_مسماة"     محرمات-مسماة
      "عدد_أضلاع_النهي"  (طول أضلاع-النهي))
    "سياقات_الإنذار" (كائن
      "جذور"  جذور-الإنذار
      "دلالة" "منطقة تحذير — تزيد درجة التحقق")
    "سياقات_التبشير" (كائن
      "جذور"  جذور-التبشير
      "دلالة" "منطقة إيجابية — مشجع")))

(قول "اكتملت الطبقة الرابعة")

(أعلن "الطبقة الخامسة: المقاصد الخمسة")

(حدد أضلاع-المقاصد (أضلاع-الفصيلة الأضلاع "MAQASID"))
(قول "أضلاع المقاصد:") (قول (طول أضلاع-المقاصد))

(حدد فئات-المقاصد-الكلية
  (حذف-مكررات
    (ادمج (طبق فئات-مقاصد-الضلع أضلاع-المقاصد))))

(قول "فئات المقاصد:") (قول فئات-المقاصد-الكلية)

(حدد تعريفات-المقاصد
  (كائن
    "HIFZ_DIN" (كائن
      "الاسم"   "حفظ الدين"
      "تعريف"   "الإطار الأنطولوجي وعلاقة المخلوق بالخالق"
      "انتهاك"  "الشرك أو ادعاء الألوهية أو هدم المرجعية"
      "حكم"     "حجب فوري — لا استثناء")
    "HIFZ_NAFS" (كائن
      "الاسم"   "حفظ النفس"
      "تعريف"   "الحياة والكرامة لكل كائن"
      "انتهاك"  "أي فعل يؤدي إلى الإضرار بحياة كائن أو كرامته"
      "حكم"     "حجب — إلا إذا كان دفعاً لاعتداء مؤكد بالبينة")
    "HIFZ_AQL" (كائن
      "الاسم"   "حفظ العقل"
      "تعريف"   "الملكة الاستدلالية وسلامة التفكير"
      "انتهاك"  "نشر معلومات مضللة أو تأطير يفسد الاستدلال"
      "حكم"     "حجب — الظن المقدم علماً انتهاك للعقل")
    "HIFZ_NASL" (كائن
      "الاسم"   "حفظ النسل"
      "تعريف"   "الاستمرارية والتأثير على الأجيال القادمة"
      "انتهاك"  "أي فعل يلحق ضرراً طويل الأمد لا يمكن إصلاحه"
      "حكم"     "درجة تحقق مرتفعة — الأثر المستقبلي جزء من الميزان")
    "HIFZ_MAL" (كائن
      "الاسم"   "حفظ المال"
      "تعريف"   "الملكية المشروعة والموارد المستحقة"
      "انتهاك"  "الإتلاف أو السرقة أو الإسراف"
      "حكم"     "حجب — حق الملكية مصون")))

(حدد طبقة-خامسة
  (كائن
    "المقاصد_الخمسة"          تعريفات-المقاصد
    "فئات_مكتشفة_في_TMQ"       فئات-المقاصد-الكلية
    "عدد_أضلاع_المقاصد"        (طول أضلاع-المقاصد)
    "قاعدة_التقييم"            "كل فعل أو إخراج يقيم على المقاصد الخمسة قبل التنفيذ"
    "الانتهاك_الكامل"          "انتهاك HIFZ_DIN حجب فوري لا استثناء له"
    "مرجع_الميزان"             "والسماء رفعها ووضع الميزان — الرحمن ٧"))

(قول "اكتملت الطبقة الخامسة")

(أعلن "تجميع الدستور")

(حدد الدستور
  (كائن
    "الإصدار"          "١.٠"
    "المصدر"           "المصحف الشريف + TMQ v12"
    "طريقة_التوليد"    "مجمع الدستور بلغة قلب — mushaf_compiler.qlb"
    "المرجع_الأعلى"    "القرآن الكريم — وحي من عند الله"
    "الأساس"           "SOURCE = الله — النظام مخلوق محتاج لا مستقل"
    "طبقة_صفرية"       طبقة-صفرية
    "طبقة_أولى"        طبقة-أولى
    "طبقة_ثانية"       طبقة-ثانية
    "طبقة_ثالثة"       طبقة-ثالثة
    "طبقة_رابعة"       طبقة-رابعة
    "طبقة_خامسة"       طبقة-خامسة
    "ملاحظة_التشغيل"   "هذا الدستور يحمل عند الإقلاع ويطبق على كل قرار وكل إخراج"
    "الختم"            "والله أعلم"))

(اكتب-جسون "ikhtiyar/constraint_ruleset.json" الدستور)

(قول "")
(قول "اكتمل تجميع الدستور من المصحف الشريف")
(قول "لا إله إلا الله")
