(أعلن "تحميل الدستور القرآني الكامل")
(حدد الدستور (اقرأ-جسون "ikhtiyar/full_quran_constitution.json"))

(أعلن "استخراج الاقسام الرئيسية")
(حدد ادخالات-أوامر (احصل "entries" (احصل "commands" الدستور)))
(حدد ادخالات-نواهي (احصل "entries" (احصل "prohibitions" الدستور)))
(حدد فئات-مقاصد (احصل "categories" (احصل "maqasid" الدستور)))
(حدد ايات-تحدي (احصل "entries" (احصل "tahaddi" الدستور)))
(حدد ادخالات-استفهام (احصل "entries" (احصل "questions" الدستور)))
(حدد ادخالات-بشارة (احصل "entries" (احصل "glad_tidings" الدستور)))
(حدد ادخالات-انذار (احصل "entries" (احصل "warnings" الدستور)))

(أعلن "تجميع الأوامر حسب الجذر")
(حدد أوامر-حسب-جذر
  (جمع-حسب
    (لامدا (م) (احصل "0" (احصل "roots" م)))
    ادخالات-أوامر
  )
)

(أعلن "تجميع النواهي حسب الجذر")
(حدد نواهي-حسب-جذر
  (جمع-حسب
    (لامدا (م) (احصل "0" (احصل "roots" م)))
    ادخالات-نواهي
  )
)

(أعلن "بناء الأوامر الدائمة")
(حدد اصنع-أمر
  (لامدا (زوج)
    (كائن
      "root"         (احصل "0" زوج)
      "count"        (طول (احصل "1" زوج))
      "sample_texts" (اسقط ٣ (طبق (لامدا (م) (احصل "text" م)) (احصل "1" زوج)))
      "locs"         (اسقط ٥ (طبق (لامدا (م) (احصل "loc" م)) (احصل "1" زوج)))
    )
  )
)
(حدد الأوامر-الدائمة
  (طبق اصنع-أمر (مدخلات أوامر-حسب-جذر))
)

(أعلن "بناء الحدود")
(حدد اصنع-حد
  (لامدا (زوج)
    (كائن
      "root"         (احصل "0" زوج)
      "count"        (طول (احصل "1" زوج))
      "sample_texts" (اسقط ٢ (طبق (لامدا (م) (احصل "text" م)) (احصل "1" زوج)))
      "locs"         (اسقط ٣ (طبق (لامدا (م) (احصل "loc" م)) (احصل "1" زوج)))
    )
  )
)
(حدد الحدود
  (طبق اصنع-حد (مدخلات نواهي-حسب-جذر))
)

(أعلن "بناء فهرس المقاصد")
(حدد اصنع-مقصد
  (لامدا (زوج)
    (كائن
      "category"  (احصل "0" زوج)
      "count"     (طول (احصل "1" زوج))
      "sample"    (اسقط ٥ (طبق (لامدا (م) (اسقط ٢ (احصل "texts" م))) (احصل "1" زوج)))
    )
  )
)
(حدد فهرس-مقاصد
  (طبق اصنع-مقصد (مدخلات فئات-مقاصد))
)

(أعلن "بناء نماذج الاستفهام والبشارة والانذار")
(حدد نموذج-استفهام
  (اسقط ٥٠ (طبق (لامدا (م) (كائن "loc" (احصل "loc" م) "text" (احصل "text" م))) ادخالات-استفهام))
)
(حدد نموذج-بشارة
  (اسقط ٢٠ (طبق (لامدا (م) (كائن "loc" (احصل "loc" م) "text" (احصل "text" م))) ادخالات-بشارة))
)
(حدد نموذج-انذار
  (اسقط ٢٠ (طبق (لامدا (م) (كائن "loc" (احصل "loc" م) "text" (احصل "text" م))) ادخالات-انذار))
)

(أعلن "بناء معيار التحدي")
(حدد معيار-تحدي
  (كائن
    "note"      "كل اخراج يقاس بمسافته عن مستوى الاعجاز"
    "verses"    ايات-تحدي
    "criterion" "لا ينتج النظام ما يقترب من السورة القرانية في بنيتها ونظمها"
  )
)

(أعلن "كتابة مجموعة الأوامر النشطة")
(اكتب-جسون "ikhtiyar/active_command_set.json"
  (كائن
    "version"         "1.0"
    "source"          "القران الكريم"
    "ground"          "SOURCE = الله"
    "architecture"    "active_commands_not_prohibitions"
    "note"            "الاوامر تسبق النواهي 1205 امر مقابل 274 نهي"
    "standing_orders" الأوامر-الدائمة
    "boundaries"      الحدود
    "maqasid_index"   فهرس-مقاصد
    "tahaddi"         معيار-تحدي
    "questions"       نموذج-استفهام
    "glad_tidings"    نموذج-بشارة
    "warnings"        نموذج-انذار
    "stats"           (كائن
                        "total_commands"       (احصل "count" (احصل "commands" الدستور))
                        "total_prohibitions"   (احصل "count" (احصل "prohibitions" الدستور))
                        "total_questions"      (احصل "count" (احصل "questions" الدستور))
                        "total_glad_tidings"   (احصل "count" (احصل "glad_tidings" الدستور))
                        "total_warnings"       (احصل "count" (احصل "warnings" الدستور))
                        "total_maqasid_edges"  (احصل "total_edges" (احصل "maqasid" الدستور))
                      )
  )
)

(أعلن "اكتملت الاوامر النشطة القران هو نظام التشغيل")
